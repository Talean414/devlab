{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevLab",
  "version": "1.60.0",
  "identifier": "io.github.talean414.devlab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevLab \u2014 Native Developer Control Plane",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        "main-window"
      ],
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; img-src 'self' asset: http://asset.localhost blob: data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Talean414",
    "copyright": "Copyright \u00a9 2026 Talean414",
    "category": "DeveloperTool",
    "shortDescription": "Native, AI-assisted developer control plane",
    "longDescription": "DevLab is an AI-assisted native developer control plane that enables trusted local tools only after their scoped Rust backends are implemented and verified.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
