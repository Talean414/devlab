{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum permissions for the DevLab main window. Native features are added only when their real backend is implemented.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "allow-get-runtime-info",
    "allow-workspace-select",
    "allow-workspace-current",
    "allow-workspace-close",
    "allow-workspace-list",
    "allow-workspace-read",
    "allow-workspace-write",
    "allow-workspace-create-file",
    "allow-workspace-create-directory",
    "allow-workspace-rename",
    "allow-workspace-delete"
  ]
}
