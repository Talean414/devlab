{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum permissions for the DevLab main window. Native features are added only when their real backend is implemented.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "allow-get-runtime-info",
    "allow-agent-audit-list",
    "allow-agent-tools-record-context",
    "allow-agent-tools-record-draft",
    "allow-workspace-select",
    "allow-workspace-current",
    "allow-workspace-close",
    "allow-workspace-list",
    "allow-workspace-read",
    "allow-workspace-write",
    "allow-workspace-apply-reviewed-draft",
    "allow-workspace-create-file",
    "allow-workspace-create-directory",
    "allow-workspace-rename",
    "allow-workspace-delete",
    "allow-terminal-create",
    "allow-terminal-list",
    "allow-terminal-snapshot",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-clear",
    "allow-terminal-kill",
    "allow-terminal-close",
    "allow-git-repository-snapshot",
    "allow-git-stage-paths",
    "allow-git-unstage-paths",
    "allow-git-stage-all",
    "allow-git-unstage-all",
    "allow-git-commit",
    "allow-git-diff",
    "allow-git-fetch",
    "allow-git-pull",
    "allow-git-push",
    "allow-git-credential-status",
    "allow-git-credential-store",
    "allow-git-credential-delete",
    "allow-docker-snapshot",
    "allow-docker-pull",
    "allow-docker-create",
    "allow-docker-start",
    "allow-docker-stop",
    "allow-docker-restart",
    "allow-docker-remove",
    "allow-docker-logs",
    "allow-database-connections",
    "allow-database-sqlite-select",
    "allow-database-schema",
    "allow-database-query",
    "allow-database-set-write-access",
    "allow-database-disconnect",
    "allow-database-postgres-connections",
    "allow-database-postgres-connect",
    "allow-database-postgres-schema",
    "allow-database-postgres-query",
    "allow-database-postgres-execute",
    "allow-database-postgres-set-write-access",
    "allow-database-postgres-disconnect",
    "allow-database-postgres-forget-password",
    "allow-http-request",
    "allow-ollama-list-models",
    "allow-ollama-chat",
    "allow-ai-credential-status",
    "allow-ai-credential-store",
    "allow-ai-credential-delete",
    "allow-ai-provider-chat",
    "allow-search-index-build",
    "allow-search-index-status",
    "allow-search-index-query",
    "allow-search-index-embed",
    "allow-search-index-clear",
    "allow-custom-endpoint-validate",
    "allow-custom-credential-status",
    "allow-custom-credential-store",
    "allow-custom-credential-delete",
    "allow-custom-endpoint-chat",
    "allow-ollama-chat-stream",
    "allow-ai-provider-chat-stream",
    "allow-custom-endpoint-chat-stream",
    "allow-ai-stream-cancel",
    "allow-test-runner-snapshot",
    "allow-test-runner-run",
    "allow-toolchain-snapshot"
  ]
}
